# KeepAliveMC Pro - Environment Variables

# API Key for authentication (generate a strong random string)
API_KEY=your_super_secret_api_key_here_change_me

# Server Port (Railway sets this automatically, leave for local dev)
PORT=3000

# CORS Origins (comma-separated, or * for development only)
CORS_ORIGINS=https://your-username.github.io,http://localhost:5500

# Default bot session duration (ms) - 24 hours
DEFAULT_DURATION_MS=86400000

# Anti-AFK interval (ms) - 3 minutes
ANTI_AFK_INTERVAL_MS=180000

# Max reconnection attempts per session
MAX_RECONNECT_ATTEMPTS=5

# Reconnection base delay (ms)
RECONNECT_BASE_DELAY_MS=5000

# Log level: error, warn, info, debug
LOG_LEVEL=info
